# Port for optional HTTP service (Render/Railway health checks)
PORT=3000

# WhatsApp Group JID
# Get this JID by adding the bot to your group and typing '/groupid'
GROUP_JID=your_group_jid_here@g.us

# Timezone for scheduled reminders (e.g., America/New_York, Africa/Lagos, Europe/London)
TZ=Africa/Lagos

# Extra administrator phone JIDs, comma-separated (in addition to actual group admins)
# Format: countrycodePhoneNumber@s.whatsapp.net (e.g., 12345678901@s.whatsapp.net)
ADMIN_JIDS=

# Thursday class schedule time override (for Mandatory Skills Qualification)
# Format: HH:MM AM/PM - HH:MM AM/PM (e.g., 11:00 AM - 1:00 PM)
THURSDAY_CLASS_TIME=11:00 AM - 1:00 PM
