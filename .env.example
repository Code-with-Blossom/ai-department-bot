# ═══════════════════════════════════════════════════════════════════
# SESSION_DATA  ← REQUIRED for Railway / Render cloud deployment
# ═══════════════════════════════════════════════════════════════════
# Your WhatsApp session, compressed and base64-encoded.
# Without this, the bot generates a new QR code on every restart.
#
# HOW TO GET IT:
#   1. Run the bot locally:  node index.js
#   2. Scan the QR code once with your WhatsApp app.
#   3. Wait until the bot logs "✅ WhatsApp connection established".
#   4. Run:  node export-session.js
#   5. Copy the SESSION_DATA=... line into Railway Environment Variables.
#
# The bot will also print SESSION_DATA automatically in the logs the
# moment it connects, so you can copy it from Railway's log viewer.
#
SESSION_DATA=

# Port for optional HTTP service (Render/Railway health checks)
PORT=3000

# WhatsApp Group JID
# Get this JID by adding the bot to your group and typing '/groupid'
GROUP_JID=your_group_jid_here@g.us

# Timezone for scheduled reminders (e.g., America/New_York, Africa/Lagos, Europe/London)
TZ=Africa/Lagos

# Extra administrator phone JIDs, comma-separated (in addition to actual group admins)
# Format: countrycodePhoneNumber@s.whatsapp.net (e.g., 12345678901@s.whatsapp.net)
ADMIN_JIDS=

# Thursday class schedule time override (for Mandatory Skills Qualification)
# Format: HH:MM AM/PM - HH:MM AM/PM (e.g., 11:00 AM - 1:00 PM)
THURSDAY_CLASS_TIME=11:00 AM - 1:00 PM
